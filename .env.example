# ─────────────────────────────────────────────────────────────────────────────
# Valuation Hypothesis Agent — model configuration
#
# The app talks to any OpenAI-COMPATIBLE endpoint. This lets you start on a free
# cloud tier with DUMMY data, then swap to a self-hosted open model (DeepSeek /
# Qwen via vLLM or Ollama) for real, confidential client work — with NO code
# changes. Just change these three values.
#
# If you leave LLM_API_KEY empty, the app runs in DEMO MODE and returns a
# realistic sample hypothesis, so you can click through the whole flow offline.
# ─────────────────────────────────────────────────────────────────────────────

# --- Option A: Groq (free tier, fast) — OpenAI-compatible -------------------
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=your_groq_key

# --- Option B: Google Gemini (free tier) — OpenAI-compatible endpoint -------
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=your_gemini_key

# --- Option C: OpenRouter (has free models) ---------------------------------
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-r1:free
# LLM_API_KEY=your_openrouter_key

# --- Option D: Self-hosted DeepSeek / Qwen (production, private) -------------
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=deepseek-ai/DeepSeek-R1
# LLM_API_KEY=not-needed

LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
